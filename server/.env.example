# ── server/.env.example ───────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is already in .gitignore.

# ── Database ──────────────────────────────────────────────────────────────────
# Option A — Local MongoDB (install MongoDB Community or use Docker):
MONGO_URI=mongodb://localhost:27017/teacher-student

# Option B — MongoDB Atlas (free tier at https://cloud.mongodb.com):
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/teacher-student?retryWrites=true&w=majority

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong random string for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-change-in-production

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS / Frontend ───────────────────────────────────────────────────────────
# URL of the React/Vite frontend.
# Local:      http://localhost:5173
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
